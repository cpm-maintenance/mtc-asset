# ============================================================
# MTC.NEXUS — Environment Variables (template)
# ============================================================
# Copy file ini ke `.env` lalu isi nilainya.
# JANGAN commit `.env` (berisi nilai asli) — hanya `.env.example` yang di-commit.
# Untuk produksi, set variabel ini di dashboard Vercel (Settings → Environment Variables).
# ============================================================

# --- Firebase Web Config (public, aman terekspos ke client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Web Push ---
# VAPID public key (Firebase Console → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
# OneSignal App ID (Dashboard OneSignal → Settings → Keys & IDs)
VITE_ONESIGNAL_APP_ID=
# URL proxy serverless untuk kirim push (default: https://mtc-asset.vercel.app/api/fcm-push)
VITE_PUSH_PROXY_URL=

# --- Layanan pihak ketiga ---
# Cloudinary: cloud name + unsigned upload preset TIDAK pakai env var.
# Nilainya bukan rahasia, dan VITE_* akan di-inline ke bundle publik bagaimanapun.
# Diatur sebagai konstanta di src/js/modules/ui.js (CLOUDINARY_CLOUD, CLOUDINARY_PRESET).
# Sentry DSN untuk error tracking
VITE_SENTRY_DSN=

# --- Server-only (JANGAN pakai prefix VITE_, hanya untuk serverless/API) ---
# ONESIGNAL_API_KEY=
