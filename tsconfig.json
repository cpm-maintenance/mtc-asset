{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/js/**/*.js", "src/js/**/*.ts"],
  "exclude": [
    "node_modules", "dist", "coverage", "tests", "e2e", "public",
    "scripts", "api", ".open", "scratch", "backups", "backup"
  ]
}
