{
  "name": "mtc-asset",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/verify-precache.mjs",
    "verify:precache": "node scripts/verify-precache.mjs",
    "preview": "vite preview",
    "build:e2e": "vite build --outDir dist-e2e",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-mtc-asset \"vitest run --config vitest.rules.config.js\"",
    "test:all": "vitest run && npm run test:rules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node scripts/backup.js",
    "backup:firebase": "node scripts/backup-firebase.js",
    "backup:quick": "scripts/backup.bat",
    "deploy": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@sentry/browser": "^10.59.0",
    "alpinejs": "^3.15.11",
    "autoprefixer": "^10.5.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.2.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "xlsx": "^0.18.5"
  }
}
